include LICENSE README.md README.en.md requirements-tested.txt
include .editorconfig .gitattributes .gitignore
recursive-include bevel_gear *.py *.html
recursive-include examples *.py *.json *.csv *.gz *.npz *.png
recursive-include docs *.md
recursive-include .github *.yml
recursive-include tests *.py
prune output
prune build
global-exclude __pycache__ *.py[cod]
